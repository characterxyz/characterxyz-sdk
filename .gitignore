# characterxyz-sdk — one repo, every platform (web, Android, Apple, Windows).
# Sections are per toolchain; the OS and editor noise is at the bottom.

# ============================================================== secrets
#
# The SDK talks to a live API with keys that can spend a brand's credits.
# A leaked .env or signing key here is a live credential, so this list is
# wide on purpose. Publishable keys in examples are fine; secret keys never.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.jks
*.keystore
!debug.keystore
*.mobileprovision
*.provisionprofile
keystore.properties
signing.properties
secrets.properties
google-services.json
GoogleService-Info.plist

# ============================================================== web (pnpm / TypeScript)
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# The lockfile is COMMITTED (pnpm-lock.yaml). A lockfile is a build input:
# characterxyz-frontend once ignored its yarn.lock and Vercel silently drifted
# onto newer dependencies.
dist/
build/
out/
*.tsbuildinfo
.turbo/
.cache/
.parcel-cache/
.vite/
.eslintcache
coverage/
.nyc_output/
/test-results/
/playwright-report/
/playwright/.cache/
*.tgz

# ============================================================== Android (Gradle / Kotlin)
.gradle/
android/**/build/
android/.kotlin/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
android/**/release/
lint-results*.xml
lint-results*.html
# Keep the wrapper so every machine builds with the same Gradle.
!gradle/wrapper/gradle-wrapper.jar

# ============================================================== Apple (Swift / Xcode / SPM)
.build/
.swiftpm/
# (No `/Packages/`: on a case-insensitive filesystem — Windows, macOS — it also
# ignores this repo's own `packages/`, every JS package. SwiftPM uses .build/.)
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive
Pods/
Carthage/Build/
Carthage/Checkouts/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
timeline.xctimeline
playground.xcworkspace

# ============================================================== Windows (.NET / C++ / Visual Studio)
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm64/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
