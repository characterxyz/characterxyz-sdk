{
  "name": "@characterxyz/react",
  "version": "0.1.0",
  "description": "Character XYZ for React: the widget as a component, and hooks over the headless SDK.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
